        "id": "request-path",
        "label": "Fresh observation to batch",
        "focus": ["robot-clients", "api-sdk", "session-gate", "deadline-scheduler", "microbatcher"],
        "note": "A fresh observation replaces stale pending work before EDF and latency-aware batch admission."
      },
      {
        "id": "backend-path",
        "label": "Backend-neutral execution",
        "focus": ["microbatcher", "backend-adapters", "policy-runtimes"],
        "note": "One narrow batch contract connects ActServe to SmolVLA, HTTP, embodied.cpp, or custom runtimes."
      },
      {
        "id": "safe-return",
        "label": "Fail-closed return path",
        "focus": ["policy-runtimes", "result-gate", "outcomes-metrics", "control-loop"],
        "note": "Identity mismatches and late actions become explicit outcomes instead of unsafe successes."
      },
      {
        "id": "async-actions",
        "label": "Optional async actions",
        "focus": ["outcomes-metrics", "action-queue", "control-loop"],
        "note": "A per-session queue can decouple action-chunk inference from low-watermark execution."
      }
    ]
  },
