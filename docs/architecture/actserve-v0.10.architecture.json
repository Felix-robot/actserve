    {
      "dot": "cyan",
      "title": "Freshness first",
      "items": [
        "Replace stale pending frames before they waste accelerator time",
        "Order surviving work by the earliest control deadline"
      ]
    },
    {
      "dot": "emerald",
      "title": "Efficient execution",
      "items": [
        "Batch only compatible requests that can still finish on time",
        "Keep SmolVLA, HTTP, embodied.cpp, and custom runtimes behind one contract"
      ]
    },
    {
      "dot": "rose",
      "title": "Fail-closed return",
      "items": [
        "Reject late or misidentified results as explicit outcomes",
