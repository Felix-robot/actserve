  "cards": [
    {
      "dot": "cyan",
      "title": "Freshness before throughput",
      "items": [
        "New frames replace stale pending work per model/session",
        "EDF and latency estimates protect the earliest deadline"
      ]
    },
    {
      "dot": "emerald",
      "title": "Runtime-neutral execution",
      "items": [
        "Compatible requests share one backend call",
        "SmolVLA, HTTP, embodied.cpp, and custom backends keep their execution role"
      ]
    },
    {
      "dot": "rose",
      "title": "Explicit safety boundary",
      "items": [
        "Late or misidentified actions never masquerade as safe success",
        "Hardware commands and robot-specific fallback remain outside ActServe"
      ]
    }
  ]
